sition : 50 } ],\n         selectionField: [{ position: 50 }],\n         identification: [{ position: 50 }] }\n    @Consumption.valueHelpDefinition: [{ entity: { name: 'ZCLDOBJ_I_TRIGGERTYPE_VH', element: 'TriggerType' } }]\n    TriggerType;\n    @UI: { \n//    lineItem: [{ position : 60 } ],\n         identification: [{ position: 60 }] } \n    RequestPayload;\n    @UI: { \n//    lineItem: [{ position : 70 } ],\n         identification: [{ position: 70 }] }\n    ResponsePayload;\n    @UI: { lineItem: [{ position : 80, criticality: 'StatusCriticality', criticalityRepresentation: #WITH_ICON } ],\n         selectionField: [{ position: 30 }],\n         identification: [{ position: 80, criticality: 'StatusCriticality', criticalityRepresentation: #WITH_ICON }] }\n    @Consumption.valueHelpDefinition: [{ entity: { name: 'ZCLDOBJ_I_STATUS_VH', element: 'Status' } }]\n    Status;\n    @UI: { lineItem: [{ position : 90 } ],\n         identification: [{ position: 90 }] }\n    ErrorMessage;\n    @UI: { lineItem: [{ position : 100 } ],\n         identification: [{ position: 100 }] }\n    Duration;\n    @UI.hidden: true\n    StatusCriticality;\n    \n}\n"
